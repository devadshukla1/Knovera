# Knovera Git Attributes
# Enforce LF line endings across repositories for Linux/Docker compatibility
* text=auto eol=lf

# Shell scripts must strictly preserve LF
*.sh text eol=lf
*.bash text eol=lf

# Windows command and PowerShell scripts retain CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.joblib binary
