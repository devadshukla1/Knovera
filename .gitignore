# ==============================================================================
# Knovera Root .gitignore (Phase 0 Foundation & Beyond)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Secrets (CRITICAL SECURITY)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*credentials*.json
*secrets*

# Whitelist safe template files (MUST BE COMMITTED)
!.env.example
!frontend/.env.example
!.env.*.example

# ------------------------------------------------------------------------------
# 2. Python & Virtual Environments
# ------------------------------------------------------------------------------
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# ------------------------------------------------------------------------------
# 3. Node.js, Frontend & Build Artifacts
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
dist/
.npm
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# 4. Testing, Coverage, Logs & Quality Caches
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.cache/
.mypy_cache/
.ruff_cache/
.vite/
test-results/
playwright-report/
frontend/playwright-report/
logs/
*.log
*.tmp
*.bak
tmp/

# ------------------------------------------------------------------------------
# 5. Local Databases, Vector Stores, Uploads & Persistent Storage
# ------------------------------------------------------------------------------
/storage/
storage/documents/
storage/knowledge_graphs/
storage/model_cache/
uploads/
postgres_data/
chroma_data/
*.db
*.sqlite
*.sqlite3
*.sqlite3-journal

# ------------------------------------------------------------------------------
# 6. Operating System & IDE Files
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# 7. Agent Teamwork Runtime & Local Overrides
# ------------------------------------------------------------------------------
.agents/**/tmp/
docker-compose.override.yml

# Local coverage, editor state, and private runtime artifacts
coverage/
*.pid
*.dump
*.sql.gz
.codex/
