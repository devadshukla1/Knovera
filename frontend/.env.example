# ==============================================================================
# Knovera Frontend Environment Configuration Template (.env.example)
# Phase 0 Foundation | Public Browser-Safe Settings
# ==============================================================================
# Copy this file to 'frontend/.env' for local frontend development:
#   PowerShell: Copy-Item frontend/.env.example frontend/.env
#
# SECURITY CONTRACT:
# Only public, browser-safe variables may carry the 'VITE_' prefix.
# NEVER add database credentials, LLM keys, or signing secrets to this file.
# ==============================================================================

VITE_API_BASE_URL=http://localhost:8000/api/v1
