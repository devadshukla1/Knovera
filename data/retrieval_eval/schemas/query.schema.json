{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RetrievalQuery",
  "type": "object",
  "required": ["query_id", "split", "category", "query"],
  "properties": {
    "query_id": { "type": "string" },
    "split": { "type": "string", "enum": ["dev", "test"] },
    "category": { "type": "string", "enum": ["exact_keyword", "technical_acronym", "conceptual", "comparative"] },
    "query": { "type": "string", "minLength": 5 }
  }
}
