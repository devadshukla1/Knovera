# ==============================================================================
# Knovera Root Environment Configuration Template (.env.example)
# Phase 0 Foundation | Safe Local Development Defaults
# ==============================================================================
# Copy this file to '.env' at the repository root for local development:
#   PowerShell: Copy-Item .env.example .env
# NEVER commit the active '.env' file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Server Settings
# ------------------------------------------------------------------------------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. Frontend CORS Configuration
# ------------------------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database Settings
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=knovera
POSTGRES_USER=knovera_app
POSTGRES_PASSWORD=change_me_locally
# SQLAlchemy 2.x connection string using psycopg 3 driver:
DATABASE_URL=postgresql+psycopg://knovera_app:change_me_locally@localhost:5432/knovera
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_TIMEOUT_SECONDS=30

# ------------------------------------------------------------------------------
# 4. ChromaDB Vector Store Settings
# ------------------------------------------------------------------------------
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_PREFIX=knovera

# ------------------------------------------------------------------------------
# 5. Local Storage Adapter Settings (Ignored Directory)
# ------------------------------------------------------------------------------
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
STORAGE_ROOT=./storage/documents
MAX_UPLOAD_MB=50
MAX_UPLOAD_SIZE_BYTES=26214400
MAX_PDF_PAGES=500
MAX_EXTRACTED_TEXT_CHARS=20000000

# ------------------------------------------------------------------------------
# 6. Authentication & Security Placeholders (Deferred to Phase 1)
# ------------------------------------------------------------------------------
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=30
# In production, generate a secure 256-bit random key: openssl rand -hex 32
AUTH_SECRET_KEY=replace_with_random_secret_in_production

# ------------------------------------------------------------------------------
# 7. LLM Provider & Generation Configuration (Phase 3 C3.4–C3.6)
# ------------------------------------------------------------------------------
LLM_PROVIDER=mock
LLM_MODEL=mock-model
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1500
LLM_TIMEOUT_SECONDS=60.0
LLM_RETRY_MAX_ATTEMPTS=3
LLM_DEFAULT_CONTEXT_TOKENS=8192
LLM_DEFAULT_RESERVED_OUTPUT_TOKENS=1500

# Google Gemini Adapter Settings
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq Adapter Settings
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Generic OpenAI-Compatible Provider Adapter Settings
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=

# Context Construction & Token Budgeting (Phase 3 C3.5)
CONTEXT_MAX_CHUNKS=8
CONTEXT_MAX_CHUNKS_PER_DOCUMENT=4
CONTEXT_SAFETY_MARGIN_TOKENS=250

# ------------------------------------------------------------------------------
# 8. Hybrid Retrieval, BM25 & Reciprocal Rank Fusion (Phase 4 C4.1–C4.3)
# ------------------------------------------------------------------------------
RETRIEVAL_MODE=hybrid
DENSE_RETRIEVAL_TOP_K=20
BM25_RETRIEVAL_TOP_K=20
BM25_K1=1.5
BM25_B=0.75
BM25_INDEX_CACHE_MAX_WORKSPACES=50
HYBRID_RETRIEVAL_TOP_K=10
RRF_K=60

# ------------------------------------------------------------------------------
# 8b. Cross-Encoder & Reranking Configuration (Phase 4 C4.4–C4.5)
# ------------------------------------------------------------------------------
RERANKER_ENABLED=true
CROSS_ENCODER_MODEL_ID=cross-encoder/ms-marco-MiniLM-L-6-v2
CROSS_ENCODER_DEVICE=cpu
CROSS_ENCODER_MAX_LENGTH=512
CROSS_ENCODER_BATCH_SIZE=16
RERANKER_CANDIDATE_K=50
RERANKER_FINAL_K=10
RERANKER_FAILURE_POLICY=error

# ------------------------------------------------------------------------------
# 8c. Retrieval Evaluation & Optimization Configuration (Phase 4 C4.7–C4.8)
# ------------------------------------------------------------------------------
RETRIEVAL_EVAL_RELEVANCE_THRESHOLD=2
RETRIEVAL_EVAL_K_VALUES=5,10,20,50
RETRIEVAL_OPTIMIZATION_MAX_CONFIGURATIONS=20
RETRIEVAL_OPTIMIZATION_RANDOM_SEED=42
RETRIEVAL_MAX_ALLOWED_RECALL_REGRESSION=0.05
RETRIEVAL_MAX_ALLOWED_NDCG_REGRESSION=0.05
RETRIEVAL_MAX_P95_LATENCY_MS=500.0

# ------------------------------------------------------------------------------
# 10. Query Intent Classification (Phase 5 C5.1–C5.6)
# ------------------------------------------------------------------------------
QUERY_INTENT_TAXONOMY_VERSION=1.0.0
QUERY_INTENT_PREPROCESSING_VERSION=1.0.0
QUERY_INTENT_WORD_NGRAM_MIN=1
QUERY_INTENT_WORD_NGRAM_MAX=2
QUERY_INTENT_CHAR_NGRAM_MIN=3
QUERY_INTENT_CHAR_NGRAM_MAX=5
QUERY_INTENT_WORD_MAX_FEATURES=50000
QUERY_INTENT_CHAR_MAX_FEATURES=100000
QUERY_INTENT_WORD_FEATURE_WEIGHT=1.0
QUERY_INTENT_CHAR_FEATURE_WEIGHT=1.0
QUERY_INTENT_RANDOM_STATE=42
QUERY_INTENT_MAX_CV_FOLDS=5
QUERY_INTENT_LOGISTIC_C=1.0
QUERY_INTENT_LOGISTIC_MAX_ITER=2000
QUERY_INTENT_SVM_C=1.0
QUERY_INTENT_SVM_MAX_ITER=5000

# ------------------------------------------------------------------------------
# 10b. Query Intent Service & Routing (Phase 5 C5.7–C5.9)
# ------------------------------------------------------------------------------
QUERY_INTENT_MODEL_DIR=models/query_intent/selected_model
QUERY_INTENT_ROUTING_ENABLED=true
QUERY_INTENT_ROUTING_CONFIG_VERSION=1.0.0
QUERY_INTENT_CONFIDENCE_THRESHOLD=0.30
QUERY_INTENT_LOW_CONFIDENCE_POLICY=default_rag
QUERY_INTENT_MODEL_FAILURE_POLICY=default_rag
QUERY_INTENT_DEFAULT_ROUTE=knowledge_retrieval
QUERY_INTENT_MAX_QUERY_LENGTH=2000

# ------------------------------------------------------------------------------
# 9. Model Placeholders (Deferred to Subsequent ML Phases)
# ------------------------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
NLI_MODEL=cross-encoder/nli-deberta-v3-base
